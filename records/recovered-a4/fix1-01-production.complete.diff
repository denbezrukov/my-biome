+/// Decodes scalar string values; unsupported UTF-16 and legacy escapes remain unknown.
+fn decoded_string(text: TokenText) -> Option<String> {
+    let mut chars = text.chars().peekable();
+    while let Some(character) = chars.next() {
+        if character != '\\' {
+            continue;
+        }
+        match chars.next()? {
+            '0' if chars.peek().is_some_and(char::is_ascii_digit) => return None,
+            '1'..='9' => return None,
+            'u' if chars.next_if_eq(&'{').is_some() => {
+                let mut value = 0u32;
+                let mut digits = 0usize;
+                loop {
+                    let digit = chars.next()?;
+                    if digit == '}' {
+                        break;
+                    }
+                    value = value.checked_mul(16)?.checked_add(digit.to_digit(16)?)?;
+                    digits += 1;
+                }
+                if digits == 0 {
+                    return None;
+                }
+                char::from_u32(value)?;
+            }
+            escape @ ('u' | 'x') => {
+                let mut value = 0u32;
+                for _ in 0..if escape == 'u' { 4 } else { 2 } {
+                    value = value * 16 + chars.next()?.to_digit(16)?;
+                }
+                char::from_u32(value)?;
+            }
+            _ => {}
+        }
+    }
+    Some(biome_js_syntax::unescape_js_string(text).to_string())
 }
 
