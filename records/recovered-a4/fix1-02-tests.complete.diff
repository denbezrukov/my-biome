+#[test]
+fn project_review_escaped_namespace_keys() {
+    let source = r#"import * as NS from './a'; NS['\u0075sed']; NS['\x75sed']; NS[`\u0075sed`];"#;
+    let f = facts(source, "/b.ts", ProjectParseStatus::Valid);
+    let uses: Vec<_> = f
+        .uses
+        .iter()
+        .filter(|usage| usage.namespace_access.is_some())
+        .collect();
+    assert_eq!(uses.len(), 3);
+    for usage in uses {
+        assert_eq!(
+            usage.namespace_access,
+            Some(ProjectNamespaceAccess::Known("used".into()))
+        );
+        assert_eq!(&source[usage.range], "NS");
+    }
+}
