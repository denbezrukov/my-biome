+#[test]
+fn project_review_opposite_facet_registry_shadowing() {
+    for source in [
+        "function f(customElements) { { type customElements = unknown; class C {} customElements.define('x', C); } }",
+        "function f(window) { { type window = unknown; class C {} window.customElements.define('x', C); } }",
+        "function f(CustomElementRegistry) { { type CustomElementRegistry = unknown; class C {} new CustomElementRegistry().define('x', C); } }",
+    ] {
+        let f = facts(source, "/a.ts", ProjectParseStatus::Valid);
+        assert_eq!(f.registrations.len(), 1);
+        assert_eq!(
+            f.registrations[0].provenance,
+            ProjectRegistryProvenance::Unknown,
+            "{source}"
+        );
+    }
+    let f = facts(
+        "{ type customElements = unknown; class C {} customElements.define('x', C); }",
+        "/a.ts",
+        ProjectParseStatus::Valid,
+    );
+    assert_eq!(
+        f.registrations[0].provenance,
+        ProjectRegistryProvenance::Global
+    );
+}
+
+#[test]
+fn project_review_opposite_facet_require_shadowing() {
+    let f = facts(
+        "function f(require) { { type require = unknown; require('./fake'); require.resolve('./fake-resolve'); } }",
+        "/a.ts",
+        ProjectParseStatus::Valid,
+    );
+    assert!(f.imports.is_empty());
+    let f = facts(
+        "{ type require = unknown; require('./real'); }",
+        "/a.ts",
+        ProjectParseStatus::Valid,
+    );
+    assert_eq!(f.imports.len(), 1);
+}
