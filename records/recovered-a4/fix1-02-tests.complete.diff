+#[test]
+fn project_review_escaped_reexport_names() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/a.ts".into(), "export const used = 1;");
+    fs.insert(
+        "/alias.ts".into(),
+        r#"export { used as "\u0075sed" } from './a';"#,
+    );
+    fs.insert(
+        "/source.ts".into(),
+        r#"export { "\u0075sed" as used } from './a';"#,
+    );
+    fs.insert(
+        "/local.ts".into(),
+        r#"const used = 1; export { used as "\u0075sed" };"#,
+    );
+    fs.insert(
+        "/namespace.ts".into(),
+        r#"export * as "\u0075sed" from './a';"#,
+    );
+    let db = support::build_js_db(
+        &fs,
+        &[
+            "/a.ts",
+            "/alias.ts",
+            "/source.ts",
+            "/local.ts",
+            "/namespace.ts",
+        ]
+        .map(BiomePath::new),
+        false,
+    );
+    for path in ["/alias.ts", "/source.ts", "/local.ts", "/namespace.ts"] {
+        assert!(
+            matches!(
+                resolve_project_export(
+                    &db,
+                    Utf8Path::new(path),
+                    "used",
+                    ProjectSymbolNamespace::Value,
+                    ProjectResolutionContext::default()
+                ),
+                ProjectExportResolution::Found(_)
+            ),
+            "{path}"
+        );
+    }
+}
