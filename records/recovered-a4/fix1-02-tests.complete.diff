+#[test]
+fn project_review_unsupported_namespace_escape() {
+    let f = facts(
+        r#"import * as NS from './a'; NS['\uD800'];"#,
+        "/b.ts",
+        ProjectParseStatus::Valid,
+    );
+    assert_eq!(
+        f.uses
+            .iter()
+            .find_map(|usage| usage.namespace_access.clone()),
+        Some(ProjectNamespaceAccess::Computed)
+    );
+    let f = facts(
+        r#"new URL('\01', import.meta.url);"#,
+        "/b.ts",
+        ProjectParseStatus::Invalid,
+    );
+    assert!(f.imports.is_empty());
+    assert!(
+        f.unknown
+            .iter()
+            .any(|fact| fact.kind == ProjectUnknownKind::Entry)
+    );
+}
