+#[test]
+fn project_review_import_type_occurrences() {
+    let source = "export type T = import('./dep').Shape; type M = typeof import('./dep');";
+    let f = facts(source, "/app/main.ts", ProjectParseStatus::Valid);
+    assert_eq!(f.imports.len(), 2);
+    let occurrences: Vec<_> = f.imports.iter().collect();
+    let type_use = occurrences[0].type_usage.as_ref().unwrap();
+    assert_eq!(type_use.kind, ProjectUseKind::Type);
+    assert_eq!(type_use.namespace, ProjectSymbolNamespace::Type);
+    assert_eq!(type_use.qualifier, ["Shape"]);
+    assert_eq!(&source[type_use.range], ".Shape");
+    let query = occurrences[1].type_usage.as_ref().unwrap();
+    assert_eq!(query.kind, ProjectUseKind::TypeQuery);
+    assert_eq!(query.namespace, ProjectSymbolNamespace::Value);
+    assert!(query.qualifier.is_empty());
+    assert_ne!(occurrences[0].range, occurrences[1].range);
+    for (specifier, occurrence) in f.imports.named_iter() {
+        assert_eq!(specifier.to_string(), "./dep");
+        assert!(occurrence.type_only);
+        assert!(occurrence.bindings.is_empty());
+        assert_eq!(&source[occurrence.specifier_range], "'./dep'");
+    }
+    let fs = MemoryFileSystem::default();
+    fs.insert("/app/main.ts".into(), source);
+    fs.insert("/app/dep.ts".into(), "export interface Shape {}");
+    let db = support::build_js_db(&fs, &[BiomePath::new("/app/main.ts")], false);
+    let module = db.module_for_path(Utf8Path::new("/app/main.ts")).unwrap();
+    let resolution = project_dependencies(
+        &db,
+        Utf8Path::new("/app/main.ts"),
+        module.kind(&db).as_js_module_info().unwrap(),
+        &[ProjectResolutionContext::default()],
+    );
+    assert_eq!(resolution.occurrences.len(), 2);
+    assert!(resolution.targets.contains(Utf8Path::new("/app/dep.ts")));
+    let nested = facts(
+        "type T = typeof import('./dep').NS.member;",
+        "/a.ts",
+        ProjectParseStatus::Valid,
+    );
+    let usage = nested
+        .imports
+        .iter()
+        .next()
+        .unwrap()
+        .type_usage
+        .as_ref()
+        .unwrap();
+    assert_eq!(usage.qualifier, ["NS", "member"]);
+    assert_eq!(usage.kind, ProjectUseKind::TypeQuery);
+}
