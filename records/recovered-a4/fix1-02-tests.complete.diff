+#[test]
+fn project_review_escaped_import_names() {
+    let f = facts(
+        r#"import { "\u0075sed" as local } from './a'; export { local };"#,
+        "/b.ts",
+        ProjectParseStatus::Valid,
+    );
+    assert_eq!(
+        f.imports.iter().next().unwrap().bindings[0].imported,
+        "used"
+    );
+    let slot = f
+        .exports
+        .iter()
+        .find(|slot| slot.name == "local" && slot.namespace == ProjectSymbolNamespace::Value)
+        .unwrap();
+    assert!(
+        matches!(&slot.target, ProjectExportTarget::Reexport { symbol, .. } if symbol == "used")
+    );
+}
