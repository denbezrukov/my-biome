+#[test]
+fn project_review_absolute_candidate_mapping_contexts() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/app/package.json".into(), "{}");
+    fs.insert("/app/main.ts".into(), "import './dist/a.js'; import 'pkg';");
+    fs.insert("/app/src/a.ts".into(), "");
+    fs.insert("/app/src/pkg.ts".into(), "");
+    fs.insert(
+        "/app/node_modules/pkg/package.json".into(),
+        r#"{"name":"pkg","main":"./dist/index.js"}"#,
+    );
+    let db = support::build_js_db(&fs, &[BiomePath::new("/app/main.ts")], false);
+    let context = ProjectResolutionContext {
+        purpose: ProjectResolutionPurpose::Declaration,
+        source_mappings: vec![
+            biome_resolver::SourceMapping {
+                from: "/app/dist/a.js".into(),
+                to: "/app/src/a.ts".into(),
+            },
+            biome_resolver::SourceMapping {
+                from: "/app/node_modules/pkg/dist/index.js".into(),
+                to: "/app/src/pkg.ts".into(),
+            },
+        ],
+        ..Default::default()
+    };
+    let module = db.module_for_path(Utf8Path::new("/app/main.ts")).unwrap();
+    let result = project_dependencies(
+        &db,
+        Utf8Path::new("/app/main.ts"),
+        module.kind(&db).as_js_module_info().unwrap(),
+        &[context],
+    );
+    assert_eq!(result.targets.len(), 2);
+    assert!(result.targets.contains(Utf8Path::new("/app/src/a.ts")));
+    assert!(result.targets.contains(Utf8Path::new("/app/src/pkg.ts")));
+}
