fn load_yaml(capture: &mut Capture, path: &Utf8Path) -> (FileId, WorkspaceMetadata) {
    let file = capture.capture(path);
    let metadata = capture
        .text(file)
        .map(read_workspace_metadata)
        .unwrap_or_default();
    capture.diagnostics(file, &metadata.diagnostics);
    (file, metadata)
}
