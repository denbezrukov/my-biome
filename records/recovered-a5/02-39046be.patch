+            )
+            .0
+            .len(),
+        1
+    );
+    assert!(matches!(
+        coordinator.publish(project, current, generation, snapshot(generation)),
+        SnapshotBuildOutcome::Published(_)
+    ));
+    assert!(
+        matches!(
+            coordinator.publish(project, old, generation, snapshot(generation)),
+            SnapshotBuildOutcome::Superseded
+        ),
+        "obsolete cache publication must be rejected too"
+    );
+    assert!(matches!(
+        coordinator.fail(project, old, generation, Coverage::Failed(Vec::new())),
+        SnapshotBuildOutcome::Superseded
+    ));
+    assert!(matches!(
+        coordinator.state(project),
+        ProjectAnalysisState::Completed { .. }
+    ));
+}
