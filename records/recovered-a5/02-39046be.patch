+#[test]
+fn snapshot_obsolete_request_cannot_reacquire_or_fail() {
+    let coordinator = ProjectAnalysisCoordinator::default();
+    let project = ProjectKey::new();
+    coordinator.open(project);
+    let old = coordinator.begin_request(project, "A".into()).unwrap();
+    assert_eq!(old, coordinator.begin_request(project, "A".into()).unwrap());
+    coordinator.begin_request(project, "B".into()).unwrap();
+    let current = coordinator.begin_request(project, "A".into()).unwrap();
+    assert_ne!(old, current, "A to B to A cannot revive the old A token");
+    let generation = coordinator.generation();
+    assert_eq!(coordinator.reacquire(project, old, generation), None);
+    assert!(matches!(
+        coordinator.fail(project, old, generation, Coverage::Failed(Vec::new())),
+        SnapshotBuildOutcome::Superseded
+    ));
+    assert!(matches!(
+        coordinator.state(project),
+        ProjectAnalysisState::Dirty { .. }
+    ));
+    assert!(matches!(
+        coordinator.publish(project, current, generation, snapshot(generation)),
+        SnapshotBuildOutcome::Published(_)
+    ));
+}
