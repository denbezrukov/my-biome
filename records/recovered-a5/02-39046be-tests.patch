+fn assert_script_acquired(snapshot: &AnalysisSnapshot, path: &str) {
+    let (file, _) = snapshot
+        .sources
+        .iter()
+        .find(|(_, source)| source.logical_path.as_str() == path)
+        .unwrap();
+    assert!(
+        snapshot.modules.contains_key(file),
+        "script must be collected: {path}"
+    );
+    assert!(
+        !snapshot
+            .inventory
+            .gaps
+            .iter()
+            .any(|gap| gap.producer == "parser"
+                && gap
+                    .location
+                    .as_ref()
+                    .is_some_and(|location| location.file == *file)),
+        "governing CommonJS manifest must select script parsing: {path}"
+    );
+}
