+#[test]
+fn snapshot_waiting_request_cannot_replace_its_successor() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/project/package.json".into(), "{}");
+    fs.insert("/project/index.ts".into(), "export const value = 1;");
+    let service = Service::new(&fs, true);
+    let mutation = service.db.analysis.mutation();
+    let (started, waiting) = std::sync::mpsc::channel();
+    *service.db.analysis.settlement_started.lock() = Some(started);
+    let barrier = Arc::new(std::sync::Barrier::new(2));
+    *service.db.analysis.after_settlement.lock() = Some(barrier.clone());
+    std::thread::scope(|scope| {
+        let old = scope.spawn(|| {
+            service
+                .server
+                .with_db_state(&service.db)
+                .try_build_project_snapshot(service.project, &Default::default())
+        });
+        waiting.recv().unwrap();
+        let current = scope.spawn(|| {
+            service.snapshot(&super::ProjectAnalysisRequest {
+                mode: biome_project_analysis::options::AnalysisMode::Production,
+                ..Default::default()
+            })
+        });
+        waiting.recv().unwrap();
+        drop(mutation);
+        barrier.wait();
+        let current = current.join().unwrap();
+        barrier.wait();
+        assert!(
+            matches!(
+                old.join().unwrap().unwrap(),
+                SnapshotBuildOutcome::Superseded
+            ),
+            "older waiter must not adopt the replacement request's generation"
+        );
+        assert!(
+            matches!(service.db.analysis.state(service.project), ProjectAnalysisState::Completed { snapshot, .. } if snapshot.revision == current.revision)
+        );
+    });
+}
