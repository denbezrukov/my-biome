+#[test]
+fn snapshot_governing_manifest_precedes_root_source() {
+    for owned in [false, true] {
+        let fs = MemoryFileSystem::default();
+        fs.insert("/project/package.json".into(), r#"{"type":"commonjs"}"#);
+        fs.insert("/project/index.js".into(), "with ({}) {}");
+        let service = Service::new(&fs, owned);
+        assert_script_acquired(&service.snapshot(&Default::default()), "index.js");
+    }
+}
+
+#[test]
+fn snapshot_governing_manifest_uses_nearest_initial_package() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/project/package.json".into(), r#"{"type":"module"}"#);
+    fs.insert("/project/index.ts".into(), "import './nested/index.js';");
+    fs.insert(
+        "/project/nested/package.json".into(),
+        r#"{"type":"commonjs"}"#,
+    );
+    fs.insert("/project/nested/index.js".into(), "with ({}) {}");
+    let service = Service::new(&fs, true);
+    assert_script_acquired(&service.snapshot(&Default::default()), "nested/index.js");
+}
+
+#[test]
+fn snapshot_governing_manifest_precedes_new_dependency() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/project/package.json".into(), r#"{"type":"module"}"#);
+    fs.insert("/project/index.ts".into(), "import 'library';");
+    fs.insert(
+        "/node_modules/library/package.json".into(),
+        r#"{"type":"module","main":"nested/index.js"}"#,
+    );
+    fs.insert(
+        "/node_modules/library/nested/package.json".into(),
+        r#"{"type":"commonjs"}"#,
+    );
+    fs.insert(
+        "/node_modules/library/nested/index.js".into(),
+        "with ({}) {}",
+    );
+    let service = Service::new(&fs, true);
+    let snapshot = service.snapshot(&Default::default());
+    let path = snapshot
+        .sources
+        .values()
+        .find(|source| {
+            source
+                .logical_path
+                .as_str()
+                .ends_with("library/nested/index.js")
+        })
+        .unwrap()
+        .logical_path
+        .clone();
+    assert_script_acquired(&snapshot, path.as_str());
+    equivalent(&service, &fs, true, &Default::default());
+}
