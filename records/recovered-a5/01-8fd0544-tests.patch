+#[test]
+fn snapshot_watch_recovery_matches_fresh_after_transient_input_failure() {
+    use crate::scanner::{ScannerWatcherBridge, WorkspaceWatcherBridge};
+    for owned in [false, true] {
+        let fs = MemoryFileSystem::default();
+        fs.insert("/project/package.json".into(), "{}");
+        fs.insert("/project/index.ts".into(), vec![255]);
+        let service = Service::new(&fs, owned);
+        let request = super::ProjectAnalysisRequest::default();
+        let workspace = service.server.with_db_state(&service.db);
+        let bridge = ScannerWatcherBridge::new((&service.server.scanner, &workspace));
+        bridge.analysis_input_error(
+            service.project,
+            Utf8Path::new("/project"),
+            "temporary read failure".into(),
+        );
+        assert!(
+            has_watch_gap(&service.snapshot(&request)),
+            "unreadable input is not recovered"
+        );
+        fs.insert("/project/index.ts".into(), "export const recovered = 1;");
+        let recovered = service.snapshot(&request);
+        assert!(
+            !has_watch_gap(&recovered),
+            "successful acquisition must retire transient watch errors"
+        );
+        equivalent(&service, &fs, owned, &request);
+        fs.insert("/project/index.ts".into(), vec![255]);
+        equivalent(&service, &fs, owned, &request);
+    }
+}
