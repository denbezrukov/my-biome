+#[test]
+fn snapshot_watch_recovery_requires_acquiring_known_external_error_path() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/project/package.json".into(), "{}");
+    fs.insert("/project/index.ts".into(), "export const value = 1;");
+    fs.insert("/external/value.ts".into(), "export const external = 1;");
+    let service = Service::new(&fs, true);
+    service.db.analysis.record_watch_input_error(
+        service.project,
+        Utf8Path::new("/external/value.ts"),
+        "external event failed".into(),
+    );
+    let request = super::ProjectAnalysisRequest::default();
+    assert!(
+        has_watch_gap(&service.snapshot(&request)),
+        "project ownership alone cannot prove an external error was reconciled"
+    );
+    fs.insert("/project/index.ts".into(), "import '/external/value';");
+    assert!(!has_watch_gap(&service.snapshot(&request)));
+    equivalent(&service, &fs, true, &request);
+}
