+#[test]
+fn snapshot_watch_recovery_preserves_overlapping_and_external_consumers() {
+    for (other_root, other_file, import) in [
+        (
+            "/project/nested",
+            "/project/nested/value.ts",
+            "import './nested/value';",
+        ),
+        (
+            "/external",
+            "/external/value.ts",
+            "import '/external/value';",
+        ),
+    ] {
+        let fs = MemoryFileSystem::default();
+        fs.insert("/project/package.json".into(), "{}");
+        fs.insert("/project/index.ts".into(), import);
+        fs.insert(format!("{other_root}/package.json").into(), "{}");
+        fs.insert(other_file.into(), vec![255]);
+        let service = Service::new(&fs, true);
+        let workspace = service.server.with_db_state(&service.db);
+        let other = workspace
+            .open_project(OpenProjectParams {
+                path: BiomePath::new(other_root),
+                open_uninitialized: true,
+            })
+            .unwrap()
+            .project_key;
+        service.db.analysis.record_watch_input_error(
+            other,
+            Utf8Path::new(other_file),
+            "overlapping input read failed".into(),
+        );
+        let request = super::ProjectAnalysisRequest::default();
+        assert!(
+            has_watch_gap(&service.snapshot(&request)),
+            "consumed input must retain error from another project"
+        );
+        fs.insert(other_file.into(), "export const recovered = 1;");
+        assert!(!has_watch_gap(&service.snapshot(&request)));
+        fs.insert(other_file.into(), vec![255]);
+        assert!(
+            has_watch_gap(&workspace.build_project_snapshot(other, &request).unwrap()),
+            "recovering one consumer must not retire another's entry"
+        );
+        assert!(
+            !has_watch_gap(&service.snapshot(&request)),
+            "retired history must not reactivate for a recovered project"
+        );
+    }
+}
