+#[test]
+fn snapshot_watch_recovery_requires_full_consumer_scope() {
+    let fs = MemoryFileSystem::default();
+    fs.insert(
+        "/project/package.json".into(),
+        r#"{"workspaces":["packages/*"]}"#,
+    );
+    fs.insert("/project/index.ts".into(), "export const root = 1;");
+    fs.insert("/project/packages/a/package.json".into(), "{}");
+    fs.insert("/project/packages/a/index.ts".into(), "export const a = 1;");
+    let service = Service::new(&fs, true);
+    service.db.analysis.record_watch_input_error(
+        service.project,
+        Utf8Path::new("/project"),
+        "consumer events were lost".into(),
+    );
+    let isolated = super::ProjectAnalysisRequest {
+        isolation: Some(super::AnalysisBoundary {
+            excluded_consumers: vec!["packages/a".into()],
+        }),
+        ..Default::default()
+    };
+    assert!(has_watch_gap(&service.snapshot(&isolated)));
+    let full = super::ProjectAnalysisRequest::default();
+    assert!(
+        !has_watch_gap(&service.snapshot(&full)),
+        "full acquisition must recover its previously excluded consumer"
+    );
+    equivalent(&service, &fs, true, &full);
+}
