+#[test]
+fn snapshot_watch_recovery_respects_sibling_project_scope() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/project/package.json".into(), "{}");
+    fs.insert("/project/index.ts".into(), vec![255]);
+    fs.insert("/sibling/package.json".into(), "{}");
+    fs.insert("/sibling/index.ts".into(), "export const sibling = 1;");
+    let service = Service::new(&fs, true);
+    let workspace = service.server.with_db_state(&service.db);
+    let sibling = workspace
+        .open_project(OpenProjectParams {
+            path: BiomePath::new("/sibling"),
+            open_uninitialized: true,
+        })
+        .unwrap()
+        .project_key;
+    let request = super::ProjectAnalysisRequest::default();
+    service.db.analysis.record_watch_input_error(
+        service.project,
+        Utf8Path::new("/project"),
+        "project read failed".into(),
+    );
+    let other = workspace.build_project_snapshot(sibling, &request).unwrap();
+    assert!(
+        !has_watch_gap(&other),
+        "sibling must not inherit another project's error"
+    );
+    assert!(
+        has_watch_gap(&service.snapshot(&request)),
+        "sibling acquisition must not retire project error"
+    );
+    fs.insert("/project/index.ts".into(), "export const recovered = 1;");
+    equivalent(&service, &fs, true, &request);
+}
