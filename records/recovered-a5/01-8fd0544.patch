+#[test]
+fn snapshot_watch_recovery_does_not_retire_concurrent_errors() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/project/package.json".into(), "{}");
+    fs.insert("/project/index.ts".into(), "export const value = 1;");
+    let service = Service::new(&fs, true);
+    service.db.analysis.record_watch_input_error(
+        service.project,
+        Utf8Path::new("/project"),
+        "old event error".into(),
+    );
+    let barrier = Arc::new(std::sync::Barrier::new(2));
+    *service.db.analysis.before_publish.lock() = Some(barrier.clone());
+    std::thread::scope(|scope| {
+        let build = scope.spawn(|| {
+            service
+                .server
+                .with_db_state(&service.db)
+                .try_build_project_snapshot(
+                    service.project,
+                    &super::ProjectAnalysisRequest::default(),
+                )
+        });
+        barrier.wait();
+        service.db.analysis.record_watch_input_error(
+            service.project,
+            Utf8Path::new("/project"),
+            "new concurrent error".into(),
+        );
+        barrier.wait();
+        assert!(matches!(
+            build.join().unwrap().unwrap(),
+            SnapshotBuildOutcome::Superseded
+        ));
+    });
+    fs.insert("/project/index.ts".into(), vec![255]);
+    let snapshot = service.snapshot(&super::ProjectAnalysisRequest::default());
+    let Coverage::Incomplete(gaps) = &snapshot.coverage else {
+        panic!("concurrent error lost")
+    };
+    for reason in ["old event error", "new concurrent error"] {
+        assert!(gaps.iter().any(|gap| matches!(&gap.reason, biome_project_analysis::coverage::GapReason::UnavailableInput(message) if message == reason)), "failed publication must not retire {reason}");
+    }
+}
+
+#[test]
+fn snapshot_watch_recovery_preserves_overlapping_and_external_consumers() {
+    for (other_root, other_file, import) in [
+        (
+            "/project/nested",
+            "/project/nested/value.ts",
+            "import './nested/value';",
+        ),
+        (
+            "/external",
+            "/external/value.ts",
+            "import '/external/value';",
+        ),
+    ] {
+        let fs = MemoryFileSystem::default();
+        fs.insert("/project/package.json".into(), "{}");
+        fs.insert("/project/index.ts".into(), import);
+        fs.insert(format!("{other_root}/package.json").into(), "{}");
+        fs.insert(other_file.into(), vec![255]);
+        let service = Service::new(&fs, true);
+        let workspace = service.server.with_db_state(&service.db);
+        let other = workspace
+            .open_project(OpenProjectParams {
+                path: BiomePath::new(other_root),
+                open_uninitialized: true,
+            })
+            .unwrap()
+            .project_key;
+        service.db.analysis.record_watch_input_error(
+            other,
+            Utf8Path::new(other_file),
+            "overlapping input read failed".into(),
+        );
+        let request = super::ProjectAnalysisRequest::default();
+        assert!(
+            has_watch_gap(&service.snapshot(&request)),
+            "consumed input must retain error from another project"
+        );
+        fs.insert(other_file.into(), "export const recovered = 1;");
+        assert!(!has_watch_gap(&service.snapshot(&request)));
+        fs.insert(other_file.into(), vec![255]);
+        assert!(
+            has_watch_gap(&workspace.build_project_snapshot(other, &request).unwrap()),
+            "recovering one consumer must not retire another's entry"
+        );
+        assert!(
+            !has_watch_gap(&service.snapshot(&request)),
+            "retired history must not reactivate for a recovered project"
+        );
+    }
+}
