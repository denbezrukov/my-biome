+fn has_watch_gap(snapshot: &AnalysisSnapshot) -> bool {
+    match &snapshot.coverage {
+        Coverage::Complete => false,
+        Coverage::Incomplete(gaps) | Coverage::Failed(gaps) => {
+            gaps.iter().any(|gap| gap.producer == "watcher")
+        }
+    }
+}
