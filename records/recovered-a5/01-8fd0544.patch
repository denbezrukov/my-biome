+#[test]
+fn snapshot_watch_recovery_preserves_persistent_capability_failures() {
+    let fs = MemoryFileSystem::default();
+    fs.insert("/project/package.json".into(), "{}");
+    fs.insert("/project/index.ts".into(), "export const value = 1;");
+    fs.insert("/sibling/package.json".into(), "{}");
+    let service = Service::new(&fs, true);
+    let workspace = service.server.with_db_state(&service.db);
+    let sibling = workspace
+        .open_project(OpenProjectParams {
+            path: BiomePath::new("/sibling"),
+            open_uninitialized: true,
+        })
+        .unwrap()
+        .project_key;
+    service.db.analysis.record_watch_failure(
+        Some(service.project),
+        Some(Utf8Path::new("/project")),
+        "cannot register watch".into(),
+    );
+    let request = super::ProjectAnalysisRequest::default();
+    assert!(has_watch_gap(&service.snapshot(&request)));
+    assert!(
+        !has_watch_gap(&workspace.build_project_snapshot(sibling, &request).unwrap()),
+        "scoped capability failure must not contaminate disjoint sibling"
+    );
+    fs.insert("/project/index.ts".into(), "export const changed = 2;");
+    assert!(
+        has_watch_gap(&service.snapshot(&request)),
+        "full reacquisition cannot repair watch registration"
+    );
+    service
+        .db
+        .analysis
+        .record_watch_failure(None, None, "watcher stopped".into());
+    assert!(has_watch_gap(
+        &workspace.build_project_snapshot(sibling, &request).unwrap()
+    ));
+}
