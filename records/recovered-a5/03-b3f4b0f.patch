+#[cfg(unix)]
+#[test]
+fn snapshot_symlinked_governing_manifest_retains_package_location_and_identity() {
+    for owned in [false, true] {
+        let mut fixture = biome_fs::TemporaryFs::new("biome-a5-snapshot-symlinked-manifest");
+        fixture.create_file("project/package.json", r#"{"type":"module"}"#);
+        fixture.create_file("project/index.ts", "import '../external/index.js';");
+        let script = fixture.create_file("external/index.js", "with ({}) {}");
+        let manifest = fixture.create_file("metadata/shared.json", r#"{"type":"commonjs"}"#);
+        let alias = fixture.working_directory.join("external/package.json");
+        std::os::unix::fs::symlink(&manifest, &alias).unwrap();
+        let root = fixture.working_directory.join("project");
+        let service = Service::with_fs(Arc::new(fixture.create_os()), &root, owned);
+        let request = super::ProjectAnalysisRequest::default();
+        let first = service.snapshot(&request);
+        assert_script_acquired(&first, script.as_str());
+        let manifest_uri = url::Url::from_file_path(&manifest).unwrap().to_string();
+        let captured: Vec<_> = first
+            .sources
+            .values()
+            .filter(|source| source.canonical_uri == manifest_uri)
+            .collect();
+        assert_eq!(
+            captured.len(),
+            1,
+            "manifest aliases share one captured identity"
+        );
+        assert_eq!(captured[0].logical_path, manifest);
+        assert!(
+            matches!(&captured[0].content, SourceContent::Available { text, .. } if text == r#"{"type":"commonjs"}"#)
+        );
+        assert!(
+            !first
+                .sources
+                .values()
+                .any(|source| source.logical_path == alias)
+        );
+        assert!(Arc::ptr_eq(&first, &service.snapshot(&request)));
+        let fresh =
+            Service::with_fs(Arc::new(fixture.create_os()), &root, owned).snapshot(&request);
+        assert_eq!(normalize_snapshot(&first), normalize_snapshot(&fresh));
+        assert_ne!(first.revision, fresh.revision);
+
+        std::fs::write(&manifest, r#"{"type":"module"}"#).unwrap();
+        let changed = service.snapshot(&request);
+        let (file, _) = changed
+            .sources
+            .iter()
+            .find(|(_, source)| source.logical_path == script)
+            .unwrap();
+        assert!(
+            changed
+                .inventory
+                .gaps
+                .iter()
+                .any(|gap| gap.producer == "parser"
+                    && gap
+                        .location
+                        .as_ref()
+                        .is_some_and(|location| location.file == *file)),
+            "changed target bytes must change the governing parser mode"
+        );
+        assert_ne!(first.revision, changed.revision);
+        let fresh =
+            Service::with_fs(Arc::new(fixture.create_os()), &root, owned).snapshot(&request);
+        assert_eq!(normalize_snapshot(&changed), normalize_snapshot(&fresh));
+        assert_ne!(changed.revision, fresh.revision);
+        assert!(
+            matches!(&captured[0].content, SourceContent::Available { text, .. } if text == r#"{"type":"commonjs"}"#),
+            "old captured text stays immutable"
+        );
+    }
+}
