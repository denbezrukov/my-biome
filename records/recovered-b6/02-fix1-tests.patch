+#[test]
+fn b6_review1_invalid_consumer_manifest_retains_catalog_uncertainty() {
+    assert_catalog_consumer_manifest_uncertainty(
+        br#"{"dependencies":{"keep":"catalog:"}"#.to_vec(),
+    );
+}
