+#[tokio::test]
+async fn review_coalesced_ready_refreshes_local_cycles_when_analysis_disabled() {
+    let mut test = Harness::new().await;
+    test.fs.insert(
+        "/project/biome.json".into(),
+        r#"{"projectAnalysis":{"enabled":false},"linter":{"rules":{"recommended":false,"suspicious":{"noImportCycles":"error"}}}}"#,
+    );
+    let a_text = "import { b } from './b.js'; export function a() { b(); }\n";
+    let b_text = "import { a } from './a.js'; export function b() { a(); }\n";
+    test.fs.insert("/project/a.js".into(), a_text);
+    test.fs.insert("/project/b.js".into(), b_text);
+    test.session.load_workspace_settings(false).await;
+    let project = test
+        .session
+        .project_for_path(camino::Utf8Path::new("/project"))
+        .unwrap();
+    let a = test.open(project, "/project/a.js", a_text);
+    let b = test.open(project, "/project/b.js", b_text);
+    test.session.update_diagnostics(a.clone()).await.unwrap();
+    let initial = test.publication(a.as_str()).await;
+    assert!(initial.diagnostics.iter().any(|diagnostic| diagnostic.code
+        == Some(lsp::NumberOrString::String(
+            "lint/suspicious/noImportCycles".into()
+        ))));
+    let states: Vec<ProjectAnalysisState> = test
+        ._server
+        .request(
+            "biome/pull_project_analysis_states",
+            "other-analysis-consumer",
+            PullProjectAnalysisStatesParams {
+                project_keys: vec![project],
+            },
+        )
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(states[0].project_key, project);
+    crate::handlers::text_document::did_change(
+        &test.session,
+        lsp::DidChangeTextDocumentParams {
+            text_document: lsp::VersionedTextDocumentIdentifier { uri: b, version: 8 },
+            content_changes: vec![lsp::TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: "export function b() {}\n".into(),
+            }],
+        },
+    )
+    .await
+    .unwrap();
+    assert!(matches!(
+        *test.factory.service_tx.borrow(),
+        ServiceNotification::ProjectAnalysisReady { .. }
+    ));
+    eprintln!(
+        "initial cycle diagnostic observed; latest coalesced notification is ProjectAnalysisReady; awaiting the unedited file refresh"
+    );
+    test.subscription.wait().await;
+    let updated = test.publication(a.as_str()).await;
+    assert_eq!(updated.version, Some(7));
+    assert!(
+        updated.diagnostics.is_empty(),
+        "the unedited file must lose its resolved import-cycle diagnostic"
+    );
+}
+
+#[tokio::test]
+async fn review_project_withdrawal_rejects_previous_local_version() {
+    let mut test = Harness::new().await;
+    let project = test.project("/project");
+    let text = "{\n\"private\":true,\n\"dependencies\":{\"unused\":\"1\"}\n}";
+    let uri = test.open(project, "/project/package.json", text);
+    let document = test.session.document(&uri).unwrap();
+    test.session
+        .publish_local_diagnostics(
+            uri.clone(),
+            &document,
+            test.session.project_diagnostics.next_sequence(),
+            vec![lsp::Diagnostic::new_simple(
+                Default::default(),
+                "previous-local-range".into(),
+            )],
+        )
+        .await;
+    test.publication(uri.as_str()).await;
+    test.session
+        .publish_project_result(project, test.pull(project))
+        .await;
+    test.publication(uri.as_str()).await;
+    let local = test.session.project_diagnostics.hooks.before_local.pause();
+    crate::handlers::text_document::did_change(
+        &test.session,
+        lsp::DidChangeTextDocumentParams {
+            text_document: lsp::VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 8,
+            },
+            content_changes: vec![lsp::TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: "{\"private\":true}".into(),
+            }],
+        },
+    )
+    .await
+    .unwrap();
+    local.wait().await;
+    test.session.reconcile_project_diagnostics(false).await;
+    let withdrawn = test.publication(uri.as_str()).await;
+    local.wait().await;
+    assert_eq!(withdrawn.version, Some(8));
+    assert!(
+        withdrawn.diagnostics.is_empty(),
+        "a project withdrawal must not relabel previous local ranges with the edited version"
+    );
+}
