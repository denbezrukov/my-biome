+async fn external_configuration_failure(missing: bool) {
+    let mut test = Harness::new().await;
+    test.fs.insert(
+        "/shared/biome.json".into(),
+        r#"{"projectAnalysis":{"enabled":true,"entry":[],"project":[]}}"#,
+    );
+    test.fs.insert(
+        "/project/package.json".into(),
+        r#"{"private":true,"dependencies":{"unused":"1"}}"#,
+    );
+    test.fs.insert("/project/index.js".into(), "export {};\n");
+    let analysis = test
+        .session
+        .project_diagnostics
+        .hooks
+        .before_analysis
+        .pause();
+    let settings = serde_json::json!({"configurationPath":"/shared/biome.json"});
+    test._server
+        .load_configuration_with_settings(settings.clone())
+        .await
+        .unwrap();
+    analysis.wait().await;
+    let project = test
+        .session
+        .project_for_path(camino::Utf8Path::new("/project"))
+        .unwrap();
+    let uri = test.open(project, "/project/index.js", "export {};\n");
+    let other = test.project("/other");
+    let old = test.pull(project);
+    let other_result = test.pull(other);
+    test.session
+        .publish_project_result(project, old.clone())
+        .await;
+    test.publication("file:///project/package.json").await;
+    test.session
+        .publish_project_result(other, other_result.clone())
+        .await;
+    test.publication("file:///other/package.json").await;
+    test.fence().await;
+    while test.notifications.try_recv().is_ok() {}
+    if missing {
+        test.fs.remove(camino::Utf8Path::new("/shared/biome.json"));
+    } else {
+        test.fs.insert("/shared/biome.json".into(), "{");
+    }
+    test._server
+        .load_configuration_with_settings(settings)
+        .await
+        .unwrap();
+    test.session.publish_project_result(project, old).await;
+    test.session
+        .publish_project_result(other, other_result)
+        .await;
+    test.fence().await;
+    let mut primary = Vec::new();
+    let mut unaffected = Vec::new();
+    while let Ok(notification) = test.notifications.try_recv() {
+        if let ServerNotification::PublishDiagnostics(params) = notification {
+            if params.uri.as_str() == "file:///project/package.json" {
+                primary.push(params);
+            } else if params.uri.as_str() == "file:///other/package.json" {
+                unaffected.push(params);
+            }
+        }
+    }
+    analysis.wait().await;
+    assert_eq!(test.session.document(&uri).unwrap().version, 7);
+    assert!(
+        !primary.is_empty(),
+        "failed external configuration must withdraw its project's contribution"
+    );
+    assert!(
+        primary.iter().all(|params| params.diagnostics.is_empty()),
+        "a result accepted under failed external configuration must not remain publishable"
+    );
+    assert!(
+        unaffected
+            .iter()
+            .any(|params| !params.diagnostics.is_empty()),
+        "an unrelated current project must retain its contribution"
+    );
+}
+
+#[tokio::test]
+async fn review_malformed_external_configuration_withdraws_project() {
+    external_configuration_failure(false).await;
+}
+
+#[tokio::test]
+async fn review_missing_external_configuration_withdraws_project() {
+    external_configuration_failure(true).await;
+}
