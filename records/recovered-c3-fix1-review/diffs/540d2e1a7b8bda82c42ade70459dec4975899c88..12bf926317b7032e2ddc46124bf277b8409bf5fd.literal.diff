+async fn replaced_local_document_identity(reopen: bool) {
+    let mut test = Harness::new().await;
+    let project = test.project("/project");
+    let text = "{\n\"private\":true,\n\"dependencies\":{\"unused\":\"1\"}\n}";
+    let uri = test.open(project, "/project/package.json", text);
+    let document = test.session.document(&uri).unwrap();
+    test.session
+        .publish_local_diagnostics(
+            uri.clone(),
+            &document,
+            test.session.project_diagnostics.next_sequence(),
+            vec![lsp::Diagnostic::new_simple(
+                Default::default(),
+                "previous-document-identity".into(),
+            )],
+        )
+        .await;
+    test.publication(uri.as_str()).await;
+    test.session
+        .publish_project_result(project, test.pull(project))
+        .await;
+    test.publication(uri.as_str()).await;
+    if reopen {
+        test.session
+            .workspace()
+            .close_file(CloseFileParams {
+                project_key: project,
+                path: biome_fs::BiomePath::new("/project/package.json"),
+            })
+            .unwrap();
+        test.session.remove_document(&uri);
+        test.open(project, "/project/package.json", text);
+    } else {
+        test.session
+            .insert_document(uri.clone(), Document::new(project, 7, "{\"private\":true}"));
+        test.session
+            .workspace()
+            .change_file(ChangeFileParams {
+                project_key: project,
+                path: biome_fs::BiomePath::new("/project/package.json"),
+                version: 8,
+                content: "{\"private\":true}".into(),
+                inline_config: None,
+                editor_features: None,
+            })
+            .unwrap();
+    }
+    assert!(!Arc::ptr_eq(
+        &document.text,
+        &test.session.document(&uri).unwrap().text
+    ));
+    test.session.reconcile_project_diagnostics(false).await;
+    let withdrawn = test.publication(uri.as_str()).await;
+    assert_eq!(withdrawn.version, Some(7));
+    assert!(
+        withdrawn.diagnostics.is_empty(),
+        "reused version numbers must not make the previous document's local slot current"
+    );
+}
+
+#[tokio::test]
+async fn review_same_version_replacement_rejects_previous_local_identity() {
+    replaced_local_document_identity(false).await;
+}
+
+#[tokio::test]
+async fn review_reopened_document_rejects_previous_local_identity() {
+    replaced_local_document_identity(true).await;
+}
