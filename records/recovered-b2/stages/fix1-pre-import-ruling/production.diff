+fn discarded_import_result(node: &JsSyntaxNode) -> bool {
+    for parent in node.ancestors().skip(1) {
+        match parent.kind() {
+            JsSyntaxKind::JS_PARENTHESIZED_EXPRESSION | JsSyntaxKind::JS_AWAIT_EXPRESSION => {}
