+#[test]
+fn b4_review_present_spread_command_arguments_are_unsupported() {
+    for command in [
+        "spawn('node', ['app.js'], ...[{cwd:'nested'}]);",
+        "spawn('node', ...[['app.js'], {cwd:'nested'}]);",
+        "new Worker('./app.js', ...[{eval:true}]);",
+    ] {
+        let f = facts(
+            &format!(
+                "import {{spawn}} from 'node:child_process'; import {{Worker}} from 'node:worker_threads'; {command}"
+            ),
+            "/app/main.js",
+            ProjectParseStatus::Valid,
+        );
+        assert_eq!(f.commands.len(), 1);
+        assert!(f.commands[0].unsupported, "{command}");
+    }
+}
