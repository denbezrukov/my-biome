+fn push_script_gap(
+    snapshot: &AnalysisSnapshot,
+    gaps: &mut Vec<ReachabilityGap>,
+    producer: &crate::scripts::ScriptProducer,
+    gap: CoverageGap,
+) {
+    let identity = producer_identity(snapshot, producer);
+    let id = GapId(format!(
+        "script-gap:{}",
+        hash(&(
+            identity,
+            &gap.reason,
+            gap.location.map(|l| (path(snapshot, l.file), l.range)),
+            &gap.domain
+        ))
+    ));
+    if gaps.iter().any(|g| g.id == id) {
+        return;
+    }
+    let consumers = match producer {
+        crate::scripts::ScriptProducer::Source { file } => [*file].into(),
+        _ => BTreeSet::new(),
+    };
+    gaps.push(ReachabilityGap {
+        id,
+        gap,
+        consumers,
+        impact: GapImpact::FileTargets,
+        active: false,
+        script_producer: Some(producer.clone()),
+    });
+}
