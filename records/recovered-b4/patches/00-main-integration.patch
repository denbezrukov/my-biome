+fn producer_identity(
+    snapshot: &AnalysisSnapshot,
+    producer: &crate::scripts::ScriptProducer,
+) -> serde_json::Value {
+    match producer {
+        crate::scripts::ScriptProducer::Source { file } => {
+            serde_json::json!({"source":path(snapshot,*file)})
+        }
+        crate::scripts::ScriptProducer::Manifest { workspace, script } => {
+            serde_json::json!({"workspace":snapshot.inventory.workspaces.iter().find(|w|w.workspace==*workspace).map(|w|&w.path),"script":script})
+        }
+    }
+}
