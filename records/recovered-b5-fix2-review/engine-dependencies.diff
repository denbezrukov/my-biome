+/// Selects provider metadata evidence with runtime priority for non-DT requests.
+pub fn provider_manifests(package: &str, resolutions: &[ScriptResolution]) -> Vec<FileId> {
+    let runtime = !package.starts_with("@types/")
+        && resolutions
+            .iter()
+            .any(|r| r.context.purpose == ResolutionPurpose::Runtime);
+    resolutions
+        .iter()
+        .filter(|r| !runtime || r.context.purpose == ResolutionPurpose::Runtime)
+        .flat_map(|r| &r.trace)
+        .filter_map(|event| match event {
+            ResolutionEvent::Manifest { file, .. } => Some(*file),
+            _ => None,
+        })
+        .collect()
+}
+
+/// Unknown provider metadata cannot establish an exhaustive peer or companion set.
+pub fn provider_uncertain(
+    provider: Option<&InstalledPackage>,
+    resolutions: &[ScriptResolution],
+) -> bool {
+    provider.is_some_and(|p| !p.metadata_known)
+        || resolutions
+            .iter()
+            .any(|r| matches!(r.outcome, ResolutionOutcome::Unknown { .. }))
+}
+
+/// Returns derived package relationships shared by acquisition and attribution.
+pub fn derived_dependencies(
+    package: &str,
+    provider: Option<&InstalledPackage>,
+) -> Vec<(String, DependencyReason)> {
+    let mut derived: Vec<_> = provider
+        .into_iter()
+        .flat_map(|p| &p.peers)
+        .map(|peer| {
+            (
+                peer.clone(),
+                DependencyReason::PeerHost {
+                    package: package.into(),
+                },
+            )
+        })
+        .collect();
+    if !package.starts_with("@types/") && !provider.is_some_and(|p| p.has_types) {
+        derived.push((
+            type_companion(package),
+            DependencyReason::TypeCompanion {
+                package: package.into(),
+            },
+        ));
+    }
+    derived
+}
