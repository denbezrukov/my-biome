+#[test]
+fn tsconfig_file_reads_retain_project_errors_and_legacy_errors() {
+    use biome_diagnostics::Diagnostic;
+    use biome_package::{Manifest, NodeJsPackage, TsConfigJson};
+    let source = r#"{"files":false,"references":[{}, {"path":42}],"compilerOptions":{"baseUrl":42,"rootDir":false}}"#;
+    let path = camino::Utf8Path::new("/project/tsconfig.json");
+    let fs = biome_fs::MemoryFileSystem::default();
+    fs.insert(path.into(), source.as_bytes());
+    let read = TsConfigJson::read_manifest(&fs, path);
+    assert_eq!(read.diagnostics().len(), 3);
+    assert_eq!(
+        read.diagnostics()
+            .iter()
+            .filter(|diagnostic| diagnostic.severity() == biome_diagnostics::Severity::Error)
+            .count(),
+        2
+    );
+    let config = read.into_deserialized().unwrap();
+    assert_eq!(config.metadata_diagnostics.len(), 5);
+    let mut excerpts = config
+        .metadata_diagnostics
+        .iter()
+        .map(|diagnostic| {
+            let range = diagnostic.location().span.unwrap();
+            &source[usize::from(range.start())..usize::from(range.end())]
+        })
+        .collect::<Vec<_>>();
+    excerpts.sort_unstable();
+    assert_eq!(excerpts, ["42", "42", "false", "false", "{}"]);
+    assert!(config.compiler_options.base_url.is_none());
+    assert_eq!(config.references.len(), 2);
+    assert!(
+        config
+            .references
+            .iter()
+            .all(|reference| reference.path.as_str().is_empty())
+    );
+    let root = biome_json_parser::parse_json(source, JsonParserOptions::default()).tree();
+    let mut package = NodeJsPackage::default();
+    package.insert_serialized_tsconfig(&root, path);
+    assert_eq!(package.diagnostics.len(), 3);
+    assert_eq!(package.tsconfig.unwrap().metadata_diagnostics.len(), 5);
+}
