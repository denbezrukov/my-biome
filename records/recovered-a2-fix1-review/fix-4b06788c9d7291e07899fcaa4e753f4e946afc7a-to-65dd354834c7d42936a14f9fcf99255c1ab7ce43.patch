+#[test]
+fn tsconfig_project_errors_preserve_legacy_diagnostics() {
+    use biome_diagnostics::{Diagnostic, Severity};
+    use biome_package::{Manifest, NodeJsPackage, TsConfigJson};
+    for source in [
+        r#"{"files":false}"#,
+        r#"{"include":42,"exclude":false}"#,
+        r#"{"references":[{}]}"#,
+        r#"{"compilerOptions":{"rootDir":false,"customConditions":42}}"#,
+    ] {
+        let parsed = biome_json_parser::parse_json(source, JsonParserOptions::default());
+        let path = camino::Utf8Path::new("/project/tsconfig.json");
+        let deserialized = TsConfigJson::deserialize_manifest(&parsed.tree(), path);
+        let warnings = if source.contains("compilerOptions") {
+            2
+        } else {
+            0
+        };
+        assert_eq!(deserialized.diagnostics().len(), warnings, "{source}");
+        assert!(
+            deserialized
+                .diagnostics()
+                .iter()
+                .all(|diagnostic| diagnostic.severity() == Severity::Warning)
+        );
+        let mut package = NodeJsPackage::default();
+        package.insert_serialized_tsconfig(&parsed.tree(), path);
+        assert_eq!(package.diagnostics.len(), warnings, "{source}");
+        assert!(
+            package
+                .diagnostics
+                .iter()
+                .all(|diagnostic| diagnostic.severity() == Severity::Warning)
+        );
+        if source.contains("references") {
+            let config = package.tsconfig.unwrap();
+            assert_eq!(config.references.len(), 1);
+            assert_eq!(config.references[0].path.as_str(), "");
+        }
+    }
+}
