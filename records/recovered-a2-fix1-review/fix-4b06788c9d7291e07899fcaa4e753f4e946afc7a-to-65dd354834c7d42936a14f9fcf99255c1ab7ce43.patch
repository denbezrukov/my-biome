+#[test]
+fn tsconfig_metadata_errors_are_owned_and_ranged() {
+    use biome_diagnostics::Diagnostic;
+    use biome_package::{Manifest, TsConfigJson};
+    let source = r#"{"files":false,"references":[{}],"compilerOptions":{"rootDir":false}}"#;
+    let root = biome_json_parser::parse_json(source, JsonParserOptions::default()).tree();
+    let parsed =
+        TsConfigJson::deserialize_manifest(&root, camino::Utf8Path::new("/project/tsconfig.json"));
+    let config = parsed.into_deserialized().unwrap();
+    assert_eq!(config.metadata_diagnostics.len(), 3);
+    let mut excerpts = config
+        .metadata_diagnostics
+        .iter()
+        .map(|diagnostic| {
+            let range = diagnostic.location().span.unwrap();
+            &source[usize::from(range.start())..usize::from(range.end())]
+        })
+        .collect::<Vec<_>>();
+    excerpts.sort_unstable();
+    assert_eq!(excerpts, ["false", "false", "{}"]);
+    assert_eq!(
+        config.metadata.unwrap().members["files"].value.as_bool(),
+        Some(false)
+    );
+    assert_eq!(config.references.len(), 1);
+    assert_eq!(config.references[0].path.as_str(), "");
+}
